# Claude Relay deployment configuration.
# Copy to .env in this directory, fill in the values, then: chmod 600 .env
# Never commit .env. Never paste these values into n8n or a chat.

# 1. Claude subscription token.
#    Generate on a TRUSTED computer with `claude setup-token` (requires a
#    Claude Pro/Max/Team/Enterprise subscription). Valid for one year.
#    This token is used ONLY by the relay container to reach Claude.
CLAUDE_CODE_OAUTH_TOKEN=REPLACE_ME

# 2. Relay API key - a separate random secret that n8n presents to the relay.
#    Generate on the VPS with:  openssl rand -hex 32
#    This is NOT the Claude token. It is the value you enter in n8n's OpenAI
#    credential "API Key" field.
CLAUDE_RELAY_API_KEY=REPLACE_WITH_RANDOM_SECRET

# 3. The existing Docker network your n8n container is attached to.
#    Find it with:  docker inspect <n8n-container> --format '{{range $k, $_ := .NetworkSettings.Networks}}{{println $k}}{{end}}'
N8N_DOCKER_NETWORK=REPLACE_ME

# Optional: structural request-shape logging for n8n compatibility debugging
# (roles, tool names, flags only - never message content or credentials).
CLAUDE_RELAY_DEBUG=0
